<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= headline %></title>
  </head>
  <body style="margin:0;padding:0;background:#f4f1ea;font-family:Georgia,'Times New Roman',serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f1ea;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#fffaf4;border-radius:16px;overflow:hidden;border:1px solid #eadfce;">
            <tr>
              <td align="center" style="padding:28px 32px 20px;background:#1c1917;">
                <img
                  src="https://ik.imagekit.io/aevhlnk0h/decoryy-light.png?updatedAt=1787252402359"
                  alt="Decoryy"
                  width="56"
                  height="56"
                  style="display:block;width:56px;height:56px;border:0;outline:none;border-radius:14px;"
                />
                <p style="margin:12px 0 0;font-size:13px;letter-spacing:0.28em;text-transform:uppercase;color:#e8d5b5;font-family:Arial,Helvetica,sans-serif;">Decoryy</p>
                <h1 style="margin:10px 0 0;font-size:26px;line-height:1.25;color:#fffaf4;font-weight:500;"><%= headline %></h1>
                <p style="margin:8px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#d6d3d1;"><%= badge %></p>
              </td>
            </tr>

            <tr>
              <td style="padding:24px 32px 8px;font-family:Arial,Helvetica,sans-serif;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <% var steps = ['Confirmed', 'On the way', 'Arrived', 'Complete']; %>
                    <% for (var i = 0; i < steps.length; i++) { %>
                    <% var stepNum = i + 1; %>
                    <% var done = stepNum < activeStep; %>
                    <% var active = stepNum === activeStep; %>
                    <td align="center" width="25%" style="vertical-align:top;">
                      <div style="width:28px;height:28px;line-height:28px;border-radius:999px;margin:0 auto 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;<%= done ? 'background:#1c1917;color:#fffaf4;' : (active ? 'background:#b45309;color:#fffaf4;border:2px solid #1c1917;' : 'background:#f5f5f4;color:#a8a29e;border:1px solid #e7e5e4;') %>">
                        <%= done ? '✓' : stepNum %>
                      </div>
                      <p style="margin:0;font-size:10px;line-height:1.35;color:<%= active ? '#1c1917' : '#a8a29e' %>;font-weight:<%= active ? '700' : '400' %>;"><%= steps[i] %></p>
                    </td>
                    <% } %>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:8px 32px 12px;color:#44403c;font-size:16px;line-height:1.55;font-family:Arial,Helvetica,sans-serif;">
                <%= intro %>
              </td>
            </tr>

            <% if (showCode) { %>
            <tr>
              <td style="padding:8px 32px 16px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px dashed #d6d3d1;border-radius:14px;background:#fafaf9;">
                  <tr>
                    <td align="center" style="padding:20px 16px;font-family:Arial,Helvetica,sans-serif;">
                      <p style="margin:0 0 8px;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#78716c;">Your completion code</p>
                      <p style="margin:0;font-size:34px;letter-spacing:0.35em;color:#1c1917;font-weight:700;font-family:'Courier New',Courier,monospace;"><%= code %></p>
                      <p style="margin:12px 0 0;font-size:13px;line-height:1.5;color:#78716c;">Share this code with <%= vendorName %> when setup is done.</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <% } %>

            <tr>
              <td style="padding:8px 32px 12px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#78716c;">
                Order <strong style="color:#1c1917;"><%= orderRef %></strong>
                &nbsp;·&nbsp; <%= scheduledAt %>
                <% if (cityName) { %>
                &nbsp;·&nbsp; <%= cityName %>
                <% } %>
              </td>
            </tr>

            <% if (showVendor) { %>
            <tr>
              <td style="padding:0 24px 12px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #eadfce;border-radius:12px;background:#fff;">
                  <tr>
                    <td style="padding:16px 18px;font-family:Arial,Helvetica,sans-serif;">
                      <p style="margin:0 0 4px;font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:#a8a29e;">Your decorator</p>
                      <p style="margin:0;font-size:16px;color:#1c1917;font-weight:600;"><%= vendorName %></p>
                      <% if (vendorPhone) { %>
                      <p style="margin:6px 0 0;font-size:14px;color:#57534e;"><%= vendorPhone %></p>
                      <% } %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <% } %>

            <% if (address) { %>
            <tr>
              <td style="padding:4px 32px 16px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#78716c;line-height:1.5;">
                <%= address %>
              </td>
            </tr>
            <% } %>

            <tr>
              <td align="center" style="padding:8px 32px 32px;">
                <a href="<%= viewUrl %>" style="display:inline-block;background:#1c1917;color:#fffaf4;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:14px;letter-spacing:0.04em;padding:12px 28px;border-radius:999px;">View booking</a>
              </td>
            </tr>
          </table>
          <p style="margin:16px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#a8a29e;">Decoryy · decorations, delivered with care</p>
        </td>
      </tr>
    </table>
  </body>
</html>
